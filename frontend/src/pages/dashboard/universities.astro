---
import Dashboard from '../../layouts/Dashboard.astro';
import EntityPage from '../../components/EntityPage.jsx';
---

<Dashboard>
  <h1>Gestão de Universities</h1>
  <EntityPage 
    client:load 
    entity="universities" 
    columns={['id', 'name', 'abbreviation']} 
    fields={[
      { name: 'id', label: 'ID', type: 'number', required: true },
      { name: 'name', label: 'Nome', required: true },
      { name: 'abbreviation', label: 'Sigla', required: true }
    ]} 
  />
</Dashboard>
