---
import Dashboard from '../../layouts/Dashboard.astro';
import EntityPage from '../../components/EntityPage.jsx';
---

<Dashboard>
  <EntityPage 
    client:load 
    entity="groups" 
    columns={['id', 'name', 'organization', 'campus', 'knowledge_areas']} 
    fields={[
      { name: 'id', label: 'ID', type: 'number' },
      { name: 'name', label: 'Name', required: true },
      { name: 'organization', label: 'Organization (Vínculos)', type: 'json_readonly' },
      { name: 'campus', label: 'Campus (Vínculos)', type: 'json_readonly' },
      { name: 'knowledge_areas', label: 'Knowledge_areas (Vínculos)', type: 'json_readonly' }
    ]} 
  />
</Dashboard>
