---
import Dashboard from '../../layouts/Dashboard.astro';
import EntityPage from '../../components/EntityPage.jsx';
---

<Dashboard>
  <EntityPage 
    client:load 
    entity="researchers" 
    columns={['id', 'name', 'initiatives', 'research_groups']} 
    fields={[
      { name: 'id', label: 'ID', type: 'number' },
      { name: 'name', label: 'Nome', required: true },
      { name: 'classification', label: 'Classificação' },
      { name: 'initiatives', label: 'Iniciativas (JSON)' },
      { name: 'research_groups', label: 'Grupos (JSON)' }
    ]} 
  />
</Dashboard>
