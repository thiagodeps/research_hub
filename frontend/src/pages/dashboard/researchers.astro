---
import Dashboard from '../../layouts/Dashboard.astro';
import EntityPage from '../../components/EntityPage.jsx';
---

<Dashboard>
  <EntityPage 
    client:load 
    entity="researchers" 
    columns={['id', 'name', 'initiatives', 'research_groups', 'knowledge_areas', 'academic_education', 'articles', 'advisorships', 'campus']} 
    fields={[
      { name: 'id', label: 'ID', type: 'number' },
      { name: 'name', label: 'Name', required: true },
      { name: 'initiatives', label: 'Initiatives (Vínculos)', type: 'json_readonly' },
      { name: 'research_groups', label: 'Research_groups (Vínculos)', type: 'json_readonly' },
      { name: 'knowledge_areas', label: 'Knowledge_areas (Vínculos)', type: 'json_readonly' },
      { name: 'academic_education', label: 'Academic_education (Vínculos)', type: 'json_readonly' },
      { name: 'articles', label: 'Articles (Vínculos)', type: 'json_readonly' },
      { name: 'advisorships', label: 'Advisorships (Vínculos)', type: 'json_readonly' },
      { name: 'campus', label: 'Campus (Vínculos)', type: 'json_readonly' }
    ]} 
  />
</Dashboard>
