---
import Dashboard from '../../layouts/Dashboard.astro';
import EntityPage from '../../components/EntityPage.jsx';
---

<Dashboard>
  <EntityPage 
    client:load 
    entity="articles" 
    columns={['id', 'title', 'doi', 'year', 'type', 'journal_conference']} 
    fields={[
      { name: 'id', label: 'ID', type: 'number' },
      { name: 'title', label: 'Título', required: true },
      { name: 'doi', label: 'DOI' },
      { name: 'year', label: 'Ano', type: 'number' },
      { name: 'type', label: 'Tipo' },
      { name: 'journal_conference', label: 'Revista/Conferência' }
    ]} 
  />
</Dashboard>
