---
// src/layouts/SplitScreen.astro
---
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ResearchHub — Login</title>
  </head>
  <body class="m-0 font-sans antialiased text-gray-900 bg-white">
    <div class="flex flex-col min-h-screen md:flex-row">
      <div class="flex flex-col items-center justify-center flex-1 p-8 text-white bg-slate-900 md:p-12">
        <img src="/logo-icon.svg" alt="ResearchHub Logo" class="w-24 h-24 mb-6 drop-shadow-xl" />
        <h1 class="mb-2 text-4xl font-bold tracking-tight">Research<span class="text-emerald-400">Hub</span></h1>
        <p class="text-lg text-slate-300 text-center max-w-sm">Sistema de Gestão de Dados de Pesquisa.</p>
        <!-- In a real app we'd have the 3 concept cards here per Figma -->
      </div>
      <div class="flex items-center justify-center flex-1 p-6 md:p-12">
        <slot />
      </div>
    </div>
  </body>
</html>
