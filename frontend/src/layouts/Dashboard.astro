---
// src/layouts/Dashboard.astro
---
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal Admin - Dashboard</title>
  </head>
  <body class="m-0 font-sans antialiased bg-slate-50 text-slate-900 flex min-h-screen">
    <div class="w-64 bg-slate-900 text-white flex flex-col min-h-screen">
      <div class="p-6 border-b border-slate-800">
        <h2 class="text-xl font-bold tracking-tight">ResearchHub</h2>
      </div>
      <nav class="flex-1 px-4 py-6 overflow-y-auto">
        <ul class="space-y-1">
          <li><a href="/dashboard" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Dashboard</a></li>
          <li><a href="/dashboard/researchers" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Pesquisadores</a></li>
          <li><a href="/dashboard/articles" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Artigos</a></li>
          <li><a href="/dashboard/groups" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Grupos de Pesquisa</a></li>
          <li><a href="/dashboard/initiatives" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Iniciativas</a></li>
          <li><a href="/dashboard/advisorships" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Orientações</a></li>
          <li><a href="/dashboard/awards" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Premiações</a></li>

          <li class="pt-5 pb-1 px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Catálogos Adicionais</li>

          <li><a href="/dashboard/students" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Alunos</a></li>
          <li><a href="/dashboard/campuses" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Campus</a></li>
          <li><a href="/dashboard/organizations" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Organizações</a></li>
          <li><a href="/dashboard/fellowships" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Bolsas</a></li>
          <li><a href="/dashboard/proficiencies" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Proficiências</a></li>
          <li><a href="/dashboard/professional_activities" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Ativ. Profissionais</a></li>
          <li><a href="/dashboard/knowledge_areas" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Áreas de Conhec.</a></li>
          <li><a href="/dashboard/languages" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Idiomas</a></li>
          <li><a href="/dashboard/research_productions" class="block px-3 py-2 rounded-md text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">Prod. Científicas</a></li>
        </ul>
      </nav>
      <div class="p-4 border-t border-slate-800">
        <a href="#" id="logout" class="block px-3 py-2 rounded-md hover:bg-red-900/50 text-red-400 transition-colors">Sair</a>
      </div>
    </div>
    <div class="flex-1 p-8 overflow-auto">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </div>
    <script>
    import { invoke } from '@tauri-apps/api/core';
    // Guard every dashboard page: a reload or deep link must not land on a
    // screen whose commands the backend will refuse.
    (async () => {
      try {
        const { authenticated } = await invoke<{ authenticated: boolean }>('session_status');
        if (!authenticated) {
          localStorage.removeItem('token');
          window.location.replace('/login');
        }
      } catch {}
    })();

    document.getElementById('logout')?.addEventListener('click', async (e) => {
      e.preventDefault();
      try { await invoke('logout'); } catch {}
      localStorage.removeItem('token');
      window.location.href = '/login';
    });
  </script>
</body>
</html>
