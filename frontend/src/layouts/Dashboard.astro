---
// src/layouts/Dashboard.astro
---
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal Admin - Dashboard</title>
  </head>
  <body class="m-0 font-sans antialiased bg-slate-50 text-slate-900 flex min-h-screen">
    <div class="w-64 bg-slate-900 text-white flex flex-col min-h-screen">
      <div class="p-6 border-b border-slate-800">
        <h2 class="text-xl font-bold tracking-tight">ResearchHub</h2>
      </div>
      <nav class="flex-1 px-4 py-6 space-y-2">
        <a href="/dashboard" class="block px-3 py-2 rounded-md hover:bg-slate-800 transition-colors">Dashboard</a>
        <a href="/dashboard/universities" class="block px-3 py-2 rounded-md hover:bg-slate-800 transition-colors">Universities</a>
        <a href="/dashboard/researchers" class="block px-3 py-2 rounded-md hover:bg-slate-800 transition-colors">Researchers</a>
      </nav>
      <div class="p-4 border-t border-slate-800">
        <a href="#" onclick="localStorage.removeItem('token'); window.location.href='/login'" class="block px-3 py-2 rounded-md hover:bg-red-900/50 text-red-400 transition-colors">Sair</a>
      </div>
    </div>
    <div class="flex-1 p-8 overflow-auto">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </div>
  </body>
</html>
